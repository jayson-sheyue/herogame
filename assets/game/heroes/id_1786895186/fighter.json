  "voice": {
    "persona": "中文，老年男性。终结乱世的天下人，幕府大将军。声音低沉沙哑，充满阅历与威严，语速沉稳缓慢，不动如山，每个字都带着不容置疑的重量。",
    "gender": "male",
    "ttsEngine": "gemini",
    "ttsModel": "",
    "ttsVoice": "",
    "ttsLanguage": "cmn-CN",
    "voiceAge": "adult",
    "speakingRate": 1,
    "pitch": -8.0,
    "lines": {
      "select": {
        "text": "儂か。",
        "emotion": "沉稳，略带疑问，从静思中被唤醒。",
        "tag": "[determination]",
        "file": "voice/select.mp3"
      },
      "intro": {
        "text": "乱世は、此処で終いじゃ。",
        "emotion": "不容置疑的宣言，语调低沉，充满终结一切的威严。",
        "tag": "[awe]",
        "file": "voice/intro.mp3"
      },
      "hurt": {
        "text": "ぬぅっ…！",
        "emotion": "压抑的短促痛呼，咬紧牙关。",
        "tag": "[agitation]",
        "file": "voice/hurt.mp3"
      },
      "super": {
        "text": "三河武士の魂、見せてやれ！",
        "emotion": "大喝，号令全军，气贯长虹。",
        "tag": "[aggression]",
        "file": "voice/super.mp3"
      },
      "win": {
        "text": "これにて、天下泰平。",
        "emotion": "尘埃落定后的平静，带有淡淡的疲惫与满足。",
        "tag": "[amusement]",
        "file": "voice/win.mp3"
      },
      "defeat": {
        "text": "まだ…天下は…",
        "emotion": "最后一口气，不甘与遗憾，声音渐弱。",
        "tag": "[frustration]",
        "file": "voice/defeat.mp3"
      }
    }
  },
