    "pitch": -8.0,
    "lines": {
      "select": {
        "text": "咱，就是规矩。",
        "emotion": "语气沉稳，不容置疑，带有君临天下的威严感。",
        "tag": "[determination]",
        "file": "voice/select.mp3"
      },
      "intro": {
        "text": "从乞丐到天子，咱什么没见过？",
        "emotion": "语调平缓，略带一丝自嘲和无尽的沧桑感，但底气十足。",
        "tag": "[awe]",
        "file": "voice/intro.mp3"
      },
      "hurt": {
        "text": "嗷嗷！",
        "emotion": "短促有力的鼻音，表达出被打断的不悦和轻蔑。",
        "tag": "[agitation]",
        "file": "voice/hurt.mp3"
      },
      "super": {
        "text": "大明国威，天上来哉！",
        "emotion": "全力吼出，声如洪钟，带着雷霆万钧的帝王之怒与绝对的毁灭意志。",
        "tag": "[anger]",
        "file": "voice/super.mp3"
      },
      "win": {
        "text": "锦衣卫，拖下去。",
        "emotion": "语气冰冷，毫无波澜，如同处理一件微不足道的杂务，充满蔑视。",
        "tag": "[amusement]",
        "file": "voice/win.mp3"
      },
      "defeat": {
        "text": "咱的江山……大明江山……",
        "emotion": "气息微弱，从不敢置信到悲愤不甘，最后化为一声低沉的叹息。",
        "tag": "[frustration]",
        "file": "voice/defeat.mp3"
      }
    }
  },
