{
  "id": "id_1786874191",
  "displayName": "甄嬛",
  "oneLiner": "后宫之主，以柔克刚的利爪玫瑰。",
  "visualLock": "身着雍容华贵的深色刺绣贵妃袍，长袖及地。头戴精致点翠发饰，配流苏步摇。双手佩戴五枚尖锐的金色凤爪护甲。仪态端庄，眼神凌厉，非战斗时将手藏于袖中。",
  "homeStageId": "",
  "kit": {
    "attack": "凤仪爪：向前优雅地挥出利爪。",
    "air_attack": "飞燕掠：在空中转身甩出利爪。",
    "attack_up": "惊鸿刺：迅速拔出发髻上的银簪向上刺出。",
    "attack_down": "凤落九天：在半空中向下俯冲，以利爪猛击地面。",
    "skill": "掌嘴：向前踏步，用凤爪打出响亮的掌掴。",
    "combo_up": "逆风解意：原地旋转，用长袖向上挥舞，形成攻击气流。",
    "combo_down": "金枝欲孽：在空中向下急坠，用穿着高底鞋的脚猛力踩踏。",
    "super": "赏你一丈红：舞动身姿，以极快速度向前方打出无数次爪击，最后以长袖将对手击飞。"
  },
  "voice": {
    "persona": "青年女声，清亮优雅，语带锋芒，笑里藏刀，不怒自威。",
    "gender": "female",
    "ttsEngine": "gemini",
    "ttsModel": "",
