    "pitch": -1.0,
    "lines": {
      "select": {
        "text": "这福气，给你要不要？",
        "emotion": "语调上扬，带着一丝轻蔑和玩味，仿佛在施舍。",
        "tag": "[amusement]",
        "file": "voice/select.mp3"
      },
      "intro": {
        "text": "这后宫，终究是本宫的天下。",
        "emotion": "沉稳有力，带着不容置疑的威严和一丝尘埃落定的感慨。",
        "tag": "[determination]",
        "file": "voice/intro.mp3"
      },
      "hurt": {
        "text": "啊！",
        "emotion": "短促、愤怒的低喝，带着被冒犯的怒意。",
        "tag": "[anger]",
        "file": "voice/hurt.mp3"
      },
      "super": {
        "text": "逆风如解意",
        "emotion": "语调狠厉，带着宣判般的冷酷和决绝，充满杀气。",
        "tag": "[aggression]",
        "file": "voice/super.mp3"
      },
      "win": {
        "text": "终究是本宫，略胜一筹。",
        "emotion": "平静中带着一丝轻蔑的笑意，仿佛一切尽在掌握。",
        "tag": "[amusement]",
        "file": "voice/win.mp3"
      },
      "defeat": {
        "text": "罢了……从头来过罢了。",
        "emotion": "先是一声无奈的叹息，随即转为不屈的坚定，带着重整旗鼓的决心。",
        "tag": "[frustration]",
        "file": "voice/defeat.mp3"
      }
    }
  },
