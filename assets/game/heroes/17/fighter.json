{
  "id": "17",
  "displayName": "艾萨克·牛顿",
  "oneLiner": "用三大定律和万有引力支配战场的科学巨匠。",
  "visualLock": "中年男性，戴着17世纪标志性的白色长卷发假发，身穿深色英国皇家学会学者长袍。配饰包括：一个红苹果、一个玻璃三棱镜、一本厚重的《自然哲学的数学原理》典籍、一个大型黄铜圆规。剪影清晰，学者风范。",
  "homeStageId": "",
  "kit": {
    "attack": "挥舞大型黄铜圆规进行横扫。",
    "air_attack": "空中挥舞大型黄铜圆规横扫。",
    "attack_up": "向上抛出苹果，将敌人击飞。",
    "attack_down": "从半空中急速下坠，落地时产生引力波震荡。",
    "skill": "向前举起三棱镜，折射出七彩光谱射线。",
    "combo_up": "在地面施放反重力场，将敌人浮空。",
    "combo_down": "在空中制造重力坍缩区域，吸附敌人。",
    "super": "召唤巨大陨石从天而降，砸向全场。"
  },
  "voice": {
    "persona": "中年男性，声线沉稳、洪亮且富有磁性，语调平缓但充满不容置疑的权威感与智力上的优越感，仿佛在宣讲宇宙真理，而非与凡人争斗。",
    "gender": "male",
    "ttsEngine": "gemini",
    "ttsModel": "",
    "ttsVoice": "",
    "ttsLanguage": "cmn-CN",
    "voiceAge": "adult",
    "speakingRate": 1,
    "pitch": 8.0,
    "lines": {
      "select": {
        "text": "The universe awaits my calculations.",
        "emotion": "沉稳自信，带着一丝不屑，仿佛在陈述一个事实。",
        "tag": "[determination]",
        "file": "voice/select.mp3"
      },
      "intro": {
        "text": "For every action, there is an equal and opposite reaction. Let the lesson begin.",
        "emotion": "教授般的口吻，冷静而充满压迫感，语速平稳，在 reaction 后稍作停顿。",
        "tag": "[awe]",
        "file": "voice/intro.mp3"
      },
      "hurt": {
        "text": "Oh!",
        "emotion": "被打中，痛、短、真的挨了打",
        "tag": "[agitation]",
        "file": "voice/hurt.mp3"
      },
      "super": {
        "text": "Hypotheses non fingo! Witness the law of universal gravitation!",
        "emotion": "从冷静的宣告转为雷霆万钧的怒吼，力量感层层递进，在喊出 gravitation 时达到顶峰。",
        "tag": "[anger]",
        "file": "voice/super.mp3"
      },
      "win": {
        "text": "A predictable outcome. Gravity always wins.",
        "emotion": "平静，略带一丝嘲弄和理所当然的傲慢，仿佛在总结实验报告。",
        "tag": "[amusement]",
        "file": "voice/win.mp3"
      },
      "defeat": {
        "text": "Impossible... the calculations... were flawless...",
        "emotion": "难以置信，从震惊转为不甘，最后气息微弱，断断续续。",
        "tag": "[frustration]",
        "file": "voice/defeat.mp3"
      }
    }
  },
